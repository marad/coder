#!/usr/bin/env bash
set -euo pipefail

# Resolve the real path of this script even when invoked via a symlink in PATH,
# so we can find agents.json living next to the original script.
SCRIPT_PATH="$(readlink -f "$0")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"
AGENTS_FILE="$SCRIPT_DIR/agents.json"

if [[ ! -f "$AGENTS_FILE" ]]; then
  echo "coder: agents.json not found at $AGENTS_FILE" >&2
  exit 1
fi

print_help() {
  cat <<'EOF'
coder — run a self-contained orchestrator/coder/reviewer loop on a coding task.

USAGE
  coder [options] <prompt>...     Prompt taken from arguments (joined by spaces).
  echo <prompt> | coder [options] Prompt taken from stdin.
  coder logs [options]            Browse and view past/active session logs.
  coder -h | --help               Show this help and exit.

OPTIONS
  --log-dir <path>   Write session logs under <path>/sessions/<id>/ instead of
                     the default location. Useful when running in a sandbox
                     that does not allow writes to ~/.local/state. With
                     `coder logs`, this is where sessions are read from.
  --no-log           Do not write any log files. Output still streams to the
                     terminal but nothing is persisted. Use this when no
                     filesystem location is writable.
  --                 End of options. Everything after is treated as the prompt.

SUBCOMMAND: logs
  coder logs                Show an interactive picker of the 5 most recent
                            sessions (running and past). Use ↑/↓ (or j/k) to
                            move, Enter to view, q to quit. The chosen
                            transcript is shown; for a session that is still
                            running, the view follows it live (tail -f) and
                            exits when the session ends.

WHAT IT DOES
  Launches Claude Code non-interactively with three subagents defined in
  agents.json (sitting next to this script):
    - orchestrator : owns the prompt; never edits files; dispatches the others.
    - coder        : implements changes and writes/runs tests.
    - reviewer     : read-only review; returns BLOCKER / NIT / PRAISE findings.
  The orchestrator loops coder→reviewer until the reviewer returns no blockers
  (max 3 cycles), then prints a final summary.

WORKING DIRECTORY
  Operates on the current working directory. Run it from the repo root (or
  whatever subtree you want it to touch). cwd is inherited as-is — the script
  does not cd anywhere.

INVOCATION MODEL
  Fully non-interactive. The run executes to completion in a single shot:
    - It cannot ask the caller follow-up questions. If the prompt is ambiguous,
      the orchestrator will make reasonable assumptions and proceed; surface
      any uncertainty by being explicit in the prompt.
    - It runs with bypassed permissions, so it WILL edit files and execute
      shell commands (build, test, git read-only) without prompting. Only run
      it on a repo whose state you are willing to have modified. Uncommitted
      work may be touched.
    - It does NOT push, open PRs, or commit unless the prompt explicitly says
      to. (Even then, prefer letting the human commit.)

GOOD PROMPTS
  One focused unit of work, with a clear definition of done. Examples:
    coder "add a --dry-run flag to scripts/deploy.sh that prints the rsync
           command instead of running it. Add a bats test."
    coder "fix the off-by-one in pkg/parse/lexer.go:tokenize when input ends
           with a backslash. Cover with a unit test."
  Avoid open-ended prompts ("clean up the codebase") — the orchestrator will
  pick a narrow interpretation that may not match your intent.

OUTPUT
  Progress streams live to stdout as the agents work, prefixed by which
  agent is talking (ORCHESTRATOR:, CODER:, REVIEWER:) and tool calls in
  square brackets. The final orchestrator reply is preceded by a line
  containing exactly:  === final ===
  Anything between the last "=== final ===" and EOF is the canonical result
  for programmatic consumers.

SESSION LOGS
  Every run is logged to:
    <log-root>/sessions/<UTC-timestamp>-<pid>/
      prompt.txt       the prompt as received
      meta.txt         session id, cwd, start/end time, exit code
      raw.jsonl        full event stream from Claude (one JSON object per line)
      transcript.txt   the formatted human-readable output
  A symlink `sessions/latest` always points to the most recent session.

  <log-root> precedence (highest first):
    1. --log-dir <path>           CLI flag
    2. $CODER_LOG_DIR              env var
    3. $XDG_STATE_HOME/coder       (or ~/.local/state/coder)
  Use --no-log to skip log writes entirely.

ENVIRONMENT
  CODER_LOG_DIR   Override the log root. Overridden by --log-dir if both are set.
  CODER_RAW=1     Show raw JSONL events on screen instead of the formatted
                  transcript. The log files are written either way (unless
                  --no-log).

EXIT CODES
  0   run completed (reviewer approved, or loop cap reached — check transcript)
  1   missing agents.json next to the script
  2   no prompt supplied (no args and stdin is a tty)
  *   any other code is propagated from `claude` itself

REQUIREMENTS
  claude (Claude Code CLI) on PATH, jq on PATH, agents.json next to this
  script's real path (symlinks are followed via readlink -f).
EOF
}

# --- `coder logs` subcommand ---------------------------------------------
# Interactive picker over recent session log dirs. Shows status (RUNNING /
# done / killed), human time, and the first line of the prompt as a hint.
# On selection: tail -f the transcript for active sessions (exits when the
# session pid dies), or page the transcript for finished ones.

cmd_logs() {
  local count=5

  local log_root
  if [[ -n "$LOG_ROOT_OVERRIDE" ]]; then
    log_root="$LOG_ROOT_OVERRIDE"
  else
    log_root="${CODER_LOG_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/coder}"
  fi
  local sessions_dir="$log_root/sessions"

  if [[ ! -d "$sessions_dir" ]]; then
    echo "coder logs: no sessions directory at $sessions_dir" >&2
    exit 1
  fi

  # Session ids sort lexically the same as chronologically (UTC stamp prefix),
  # so a reverse name sort gives newest-first. The `latest` symlink is
  # type=l, not type=d, so it's naturally excluded.
  local session_dirs=()
  while IFS= read -r d; do
    session_dirs+=("$d")
  done < <(find "$sessions_dir" -mindepth 1 -maxdepth 1 -type d | sort -r | head -n "$count")

  if [[ ${#session_dirs[@]} -eq 0 ]]; then
    echo "coder logs: no sessions found in $sessions_dir" >&2
    exit 1
  fi

  if [[ ! -t 1 ]] || [[ ! -r /dev/tty ]] || [[ ! -w /dev/tty ]]; then
    echo "coder logs: requires a TTY for interactive selection" >&2
    exit 1
  fi

  local labels=() statuses=() pids=()
  local i
  for i in "${!session_dirs[@]}"; do
    local dir="${session_dirs[$i]}"
    local sid
    sid=$(basename "$dir")

    # Status: meta.txt gets `exit_code:` appended in the EXIT trap of a run.
    # If absent and the recorded pid is still alive → RUNNING. Otherwise it
    # was killed before the trap could fire (e.g. SIGKILL, host crash).
    local pid="${sid##*-}"
    local status
    if [[ -f "$dir/meta.txt" ]] && grep -q '^exit_code:' "$dir/meta.txt"; then
      status="done   "
    elif [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
      status="RUNNING"
    else
      status="killed "
    fi
    statuses+=("$status")
    pids+=("$pid")

    # Convert UTC stamp in session id to local-tz human time when possible.
    local ts="${sid%%-*}"           # 20260502T142301Z
    local d="${ts:0:8}"             # 20260502
    local t="${ts:9:6}"             # 142301
    local human
    human=$(date -d "${d:0:4}-${d:4:2}-${d:6:2}T${t:0:2}:${t:2:2}:${t:4:2}Z" '+%Y-%m-%d %H:%M' 2>/dev/null) \
      || human="${d:0:4}-${d:4:2}-${d:6:2} ${t:0:2}:${t:2:2}"

    local preview="(no prompt)"
    if [[ -s "$dir/prompt.txt" ]]; then
      preview=$(head -n1 "$dir/prompt.txt" | tr '\t' ' ' | tr -d '\r')
      [[ -z "$preview" ]] && preview="(empty prompt)"
    fi
    local maxw=60
    if [[ ${#preview} -gt $maxw ]]; then
      preview="${preview:0:$((maxw - 1))}…"
    fi

    labels+=("[$status] $human  $preview")
  done

  # --- interactive menu --------------------------------------------------
  local n=${#labels[@]}
  local sel=0

  local stty_orig
  stty_orig=$(stty -g </dev/tty)
  _logs_cleanup() {
    [[ -n "${stty_orig:-}" ]] && stty "$stty_orig" </dev/tty 2>/dev/null || true
    printf '\033[?25h' >/dev/tty 2>/dev/null || true   # show cursor
  }
  trap _logs_cleanup EXIT INT TERM

  stty -echo -icanon min 1 time 0 </dev/tty
  printf '\033[?25l' >/dev/tty                          # hide cursor

  printf 'coder logs — pick a session (↑/↓ or j/k to move, Enter to view, q to quit)\n\n' >/dev/tty

  _draw() {
    local j
    for j in "${!labels[@]}"; do
      if [[ $j -eq $sel ]]; then
        printf '\033[7m> %s\033[0m\n' "${labels[$j]}" >/dev/tty
      else
        printf '  %s\n' "${labels[$j]}" >/dev/tty
      fi
    done
  }

  _draw

  while true; do
    local key
    IFS= read -rsn1 key </dev/tty || break
    case "$key" in
      $'\x1b')
        # arrow key: ESC [ A/B/C/D. Use plain assignments rather than ((sel++))
        # — under `set -e`, post-increment returning the pre-increment value
        # of 0 would kill the script the first time you arrow down from the
        # top entry.
        local rest=""
        IFS= read -rsn2 -t 0.1 rest </dev/tty || true
        case "$rest" in
          '[A') (( sel > 0 ))     && sel=$((sel - 1)) ;;
          '[B') (( sel < n - 1 )) && sel=$((sel + 1)) ;;
        esac
        ;;
      '')   break ;;                                    # Enter
      'k')  (( sel > 0 ))     && sel=$((sel - 1)) ;;
      'j')  (( sel < n - 1 )) && sel=$((sel + 1)) ;;
      'q'|'Q') sel=-1; break ;;
    esac
    # redraw: cursor up n rows, clear from cursor to end of screen
    printf '\033[%dA\033[J' "$n" >/dev/tty
    _draw
  done

  _logs_cleanup
  trap - EXIT INT TERM

  if [[ $sel -lt 0 ]]; then
    return 0
  fi

  local chosen="${session_dirs[$sel]}"
  local transcript="$chosen/transcript.txt"
  local sid pid status
  sid=$(basename "$chosen")
  pid="${pids[$sel]}"
  status="${statuses[$sel]}"

  echo
  echo "[session: $chosen]"
  echo

  if [[ ! -f "$transcript" ]]; then
    echo "coder logs: no transcript at $transcript (session may have written raw events only)" >&2
    if [[ -f "$chosen/raw.jsonl" ]]; then
      transcript="$chosen/raw.jsonl"
      echo "coder logs: showing raw.jsonl instead" >&2
    else
      exit 1
    fi
  fi

  if [[ "$status" == "RUNNING" ]] && [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
    # Follow live; --pid lets tail exit cleanly when the writer dies. Fall
    # back to plain -f if the host's tail doesn't grok --pid.
    if tail --help 2>&1 | grep -q -- '--pid'; then
      exec tail -n +1 -f --pid="$pid" "$transcript"
    else
      exec tail -n +1 -f "$transcript"
    fi
  else
    if command -v less >/dev/null 2>&1; then
      exec less -R "$transcript"
    else
      exec cat "$transcript"
    fi
  fi
}
# -------------------------------------------------------------------------

# --- argument parsing ----------------------------------------------------
LOG_ROOT_OVERRIDE=""
NO_LOG=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      print_help; exit 0 ;;
    --log-dir)
      [[ $# -ge 2 ]] || { echo "coder: --log-dir requires a path argument" >&2; exit 2; }
      LOG_ROOT_OVERRIDE="$2"; shift 2 ;;
    --log-dir=*)
      LOG_ROOT_OVERRIDE="${1#--log-dir=}"; shift ;;
    --no-log)
      NO_LOG=1; shift ;;
    --)
      shift; break ;;
    -*)
      echo "coder: unknown option: $1" >&2
      echo "       use -h for help" >&2
      exit 2 ;;
    *)
      break ;;
  esac
done

# Subcommand dispatch. Recognised after option parsing so flags like
# --log-dir apply to subcommands too. `coder logs` is the only subcommand
# today; if a user genuinely wants "logs" as a literal prompt, they can
# pass it after `--`.
if [[ $# -gt 0 && "$1" == "logs" ]]; then
  shift
  cmd_logs "$@"
  exit $?
fi

if [[ $# -gt 0 ]]; then
  prompt="$*"
elif [[ ! -t 0 ]]; then
  prompt="$(cat)"
else
  print_help >&2
  echo >&2
  echo "error: no prompt supplied" >&2
  exit 2
fi
# -------------------------------------------------------------------------

# --- session log setup ---------------------------------------------------
# Precedence for log root: --log-dir > $CODER_LOG_DIR > XDG default.
# --no-log disables file writes entirely (for sandboxes with no writable path).
RAW_LOG=/dev/null
TRANSCRIPT_LOG=/dev/null

if [[ "$NO_LOG" == "1" ]]; then
  echo "[session logging disabled]" >&2
else
  if [[ -n "$LOG_ROOT_OVERRIDE" ]]; then
    LOG_ROOT="$LOG_ROOT_OVERRIDE"
  else
    LOG_ROOT="${CODER_LOG_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/coder}"
  fi
  SESSION_ID="$(date -u +%Y%m%dT%H%M%SZ)-$$"
  SESSION_DIR="$LOG_ROOT/sessions/$SESSION_ID"

  if ! mkdir -p "$SESSION_DIR" 2>/dev/null; then
    echo "coder: cannot create log dir at $SESSION_DIR" >&2
    echo "       use --log-dir <path> to choose a writable location," >&2
    echo "       or --no-log to run without writing logs." >&2
    exit 1
  fi

  printf '%s\n' "$prompt" > "$SESSION_DIR/prompt.txt"
  {
    echo "session_id: $SESSION_ID"
    echo "cwd:        $PWD"
    echo "started:    $(date -Iseconds)"
    echo "agents:     $AGENTS_FILE"
  } > "$SESSION_DIR/meta.txt"

  # Maintain a `latest` symlink so you can `cat $LOG_ROOT/sessions/latest/transcript.txt`.
  ln -sfn "$SESSION_ID" "$LOG_ROOT/sessions/latest" 2>/dev/null || true

  # Append end time + exit code on the way out, regardless of how we exit.
  trap '{
    rc=$?
    echo "ended:      $(date -Iseconds)"
    echo "exit_code:  $rc"
  } >> "$SESSION_DIR/meta.txt"' EXIT

  RAW_LOG="$SESSION_DIR/raw.jsonl"
  TRANSCRIPT_LOG="$SESSION_DIR/transcript.txt"
  echo "[session: $SESSION_DIR]" >&2
fi
# -------------------------------------------------------------------------

# stream-json + verbose emits one JSON event per line as the run progresses.
# Pipeline:
#   claude → tee raw.jsonl → formatter (jq) → tee transcript.txt → terminal
# Set CODER_RAW=1 to skip the formatter and show raw JSONL on screen
# (the files are still written either way).

format_stream() {
  if [[ "${CODER_RAW:-0}" == "1" ]]; then
    cat
  else
    jq -r --unbuffered '
      (.subagent_type // .agent // .message.subagent_type // "orchestrator") as $who
      | if .type == "system" and (.subtype // "") == "init" then
          "[init] session started"
        elif .type == "assistant" then
          (.message.content // [])
          | map(
              if .type == "text" then
                ($who | ascii_upcase) + ": " + (.text // "")
              elif .type == "tool_use" then
                "[" + $who + " → tool: " + (.name // "?")
                + (if .input.subagent_type then " (" + .input.subagent_type + ")" else "" end)
                + (if .input.description then " — " + .input.description else "" end)
                + "]"
              else empty end
            )
          | .[]
        elif .type == "user" then
          (.message.content // [])
          | map(
              if .type == "tool_result" then
                "[result ← " + $who + "]"
              else empty end
            )
          | .[]
        elif .type == "result" then
          "\n=== final ===\n" + (.result // "")
        else empty end
    '
  fi
}

claude \
  --agents "$(cat "$AGENTS_FILE")" \
  --agent orchestrator \
  --permission-mode bypassPermissions \
  --print \
  --output-format stream-json \
  --verbose \
  "$prompt" \
| tee "$RAW_LOG" \
| format_stream \
| tee "$TRANSCRIPT_LOG"
